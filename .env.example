# Copy this file to .env and fill in your key. Never commit .env.
GEMINI_API_KEY=

# Optional: override the default model — check Google AI Studio for the current
# model list and your account's actual rate limits, both shift over time
# (gemini-2.5-flash-lite was already deprecated for new accounts by the time
# this was written; gemini-3.5-flash-lite is the current lightweight option).
VOICE_PROXY_MODEL=gemini-3.5-flash-lite
